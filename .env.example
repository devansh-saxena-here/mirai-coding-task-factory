# ==============================================================================
# MIRAI — Coding Task Factory Environment Configuration
# Copy this file to `.env` for local development and fill in your server keys.
# NEVER commit `.env` or put real API keys in version control.
# ==============================================================================

# --- Server Runtime -----------------------------------------------------------
APP_NAME=MIRAI
ENV=development
PORT=3000

# --- AI Provider Keys & Models (Server-Side Only) -----------------------------
# Google GenAI SDK — required for task, reference solution, test suite synthesis,
# 1-Click AI Auto-Repair, and Stage 5 Gemini agent evaluation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Groq API — required for live Stage 5 GPT-OSS 120B / 20B & Qwen 3.8 27B evaluation.
GROQ_API_KEY=

# Adaption AI API — required for live Stage 5 Qwen 3.5 397B & SEA-LION v5 397B evaluation.
ADAPTION_API_KEY=
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1

# --- GitHub Repository Ingestion ----------------------------------------------
# Optional Personal Access Token to raise GitHub API rate limits during repo intake.
GITHUB_TOKEN=

# --- Storage & Ownership ------------------------------------------------------
# Directory for persisted snapshots, tasks, artifacts, and execution logs.
CTF_STATE_DIR=.mirai-state

# Optional email to claim pre-auth legacy local `.mirai-state` records on sign-in.
LEGACY_OWNER_EMAIL=

# --- Rate Limits & Request Quotas (Optional) ----------------------------------
CTF_SHARED_MODE=
CTF_REQUESTS_PER_MINUTE=
CTF_MODEL_REQUESTS_PER_DAY=
CTF_GLOBAL_MODEL_REQUESTS_PER_DAY=

# --- Frontend Build Configuration ---------------------------------------------
# Leave empty to use same-origin API routes served by the unified Express server.
VITE_API_BASE_URL=